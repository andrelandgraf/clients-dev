{
  "name": "@agent-tooling/clients",
  "version": "0.1.0",
  "description": "Evidence-backed AI client configuration and behavior data",
  "type": "module",
  "license": "MIT AND CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-tooling/clients-dev.git",
    "directory": "packages/clients"
  },
  "homepage": "https://clients.dev",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "exports": {
